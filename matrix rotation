import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();
        long r = sc.nextLong();

        int[][] matrix = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            ArrayList<Integer> elements = new ArrayList<>();

            int top = layer;
            int left = layer;
            int bottom = m - layer - 1;
            int right = n - layer - 1;

            // Left side: top -> bottom
            for (int i = top; i <= bottom; i++) {
                elements.add(matrix[i][left]);
            }

            // Bottom side: left+1 -> right
            for (int j = left + 1; j <= right; j++) {
                elements.add(matrix[bottom][j]);
            }

            // Right side: bottom-1 -> top
            for (int i = bottom - 1; i >= top; i--) {
                elements.add(matrix[i][right]);
            }

            // Top side: right-1 -> left+1
            for (int j = right - 1; j > left; j--) {
                elements.add(matrix[top][j]);
            }

            int len = elements.size();
            int rotation = (int)(r % len);

            int index = rotation;

            // Put rotated values back
            // Left side
            for (int i = top; i <= bottom; i++) {
                matrix[i][left] = elements.get(index);
                index = (index + 1) % len;
            }

            // Bottom side
            for (int j = left + 1; j <= right; j++) {
                matrix[bottom][j] = elements.get(index);
                index = (index + 1) % len;
            }

            // Right side
            for (int i = bottom - 1; i >= top; i--) {
                matrix[i][right] = elements.get(index);
                index = (index + 1) % len;
            }

            // Top side
            for (int j = right - 1; j > left; j--) {
                matrix[top][j] = elements.get(index);
                index = (index + 1) % len;
            }
        }

        // Print result
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(matrix[i][j] + " ");
            }
            System.out.println();
        }

        sc.close();
    }
}
