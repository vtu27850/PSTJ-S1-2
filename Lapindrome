import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        if (!scanner.hasNextInt()) return;
        
        int T = scanner.nextInt();
        while (T-- > 0) {
            String s = scanner.next();
            int n = s.length();
            int mid = n / 2;
            
            int[] left = new int[26];
            int[] right = new int[26];
            
            for (int i = 0; i < mid; i++) {
                left[s.charAt(i) - 'a']++;
            }
            
            int rightStart = (n % 2 != 0) ? mid + 1 : mid;
            for (int i = rightStart; i < n; i++) {
                right[s.charAt(i) - 'a']++;
            }
            
            boolean isLapindrome = true;
            for (int i = 0; i < 26; i++) {
                if (left[i] != right[i]) {
                    isLapindrome = false;
                    break;
                }
            }
            
            if (isLapindrome) {
                System.out.println("YES");
            } else {
                System.out.println("NO");
            }
        }
        scanner.close();
    }
}
